{
  "name": "gameserver-card",
  "version": "1.0.0",
  "description": "Live, animated SVG status cards for Minecraft, Source engine and FiveM servers. Zero runtime dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "examples": "node scripts/examples.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "minecraft",
    "source-engine",
    "fivem",
    "server-status",
    "svg",
    "readme",
    "github-readme",
    "a2s"
  ],
  "author": "Turhan Sarımsak",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
